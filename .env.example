# AutoCoach Agent Configuration Example
# Copy this file to .env and fill in your credentials

# LiveKit Server Configuration (Self-Hosted or Cloud)
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Google Gemini API Configuration
# Gemini 3.8 Live API key from Google AI Studio
GOOGLE_API_KEY=your-gemini-api-key

# LiveKit Agent Worker Settings
AGENT_NAME=autocoach-customer-sts
HEALTH_CHECK_HOST=0.0.0.0
HEALTH_CHECK_PORT=8081
SHUTDOWN_TIMEOUT_SECONDS=60.0
WORKER_LOAD_THRESHOLD=0.7

# Post-Session Evaluation & Reporting Webhook
AUTOCOACH_REPORTS_URL=http://127.0.0.1:8000/api/v1/sessions/reports
AUTOCOACH_REPORTS_TIMEOUT_SECONDS=10.0

# Default Persona / Scenario Settings (Used when no metadata is provided)
DEFAULT_SCENARIO=dental_scheduling
DEFAULT_VOICE=Puck
DEFAULT_LANGUAGE=en
DEFAULT_DIFFICULTY=medium
